---
import { getTool } from "../lib/tools";

// The stamp creator used to live here, back when it was called "Invert a
// design". Links to /invert/ are out in the world — and search engines have the
// page indexed — so the address stays, as a redirect to where the tool moved.
//
// A static site cannot answer with a 301, so this is the next best thing: the
// canonical link tells crawlers which URL counts, the meta refresh moves a
// browser with no JavaScript, and location.replace() moves the rest without
// leaving an entry in the back button.

const oTool = getTool("stamp");
const base = import.meta.env.BASE_URL;
const target = `${base}${oTool.slug}`;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="noindex, follow" />
        <link rel="canonical" href={`https://bbraeu.github.io${target}`} />
        <meta http-equiv="refresh" content={`0; url=${target}`} />
        <title>Moved — {oTool.label} | LaserKit</title>
        <script is:inline define:vars={{ target }}>
            location.replace(target);
        </script>
    </head>
    <body style="background:#020617;color:#94a3b8;font:16px/1.6 system-ui,sans-serif;padding:3rem">
        <p>
            “Invert a design” is now the <a href={target} style="color:#22d3ee">{oTool.label}</a>.
        </p>
    </body>
</html>
