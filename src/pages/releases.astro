---
import Layout from "../layouts/Layout.astro";
import ToolIcon from "../components/ToolIcon.astro";
import { RELEASES, REPO } from "../lib/releases";
import { TOOLS } from "../lib/tools";

const base = import.meta.env.BASE_URL;

/** Group by major.minor line, so a page of patches does not read as a wall. */
const byLine = RELEASES.reduce<Record<string, typeof RELEASES>>((acc, r) => {
    const line = `${r.version.split(".")[0]}.x`;
    (acc[line] ??= []).push(r);
    return acc;
}, {});

const lines = Object.entries(byLine);

const dateLabel = (s: string): string =>
    new Date(`${s}T12:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
---

<Layout
    title="Release notes — every version of LaserKit"
    description="What changed in every release of LaserKit, newest first: the nesting tool, the living hinge, rounded boxes, text round a circle, the box generator, the text generator, the workspace redesign and the xTool converter it all started as."
>
    <section class="relative px-4 pt-32 pb-10">
        <div class="mx-auto w-[min(56rem,100%)]">
            <p class="reveal is-visible text-xs font-medium tracking-widest text-cyan-300 uppercase">Release notes</p>
            <h1 class="reveal is-visible mt-3 text-4xl font-bold tracking-tight text-white sm:text-5xl">
                Everything that <span class="text-gradient">changed</span>
            </h1>
            <p class="reveal is-visible mt-4 max-w-2xl text-base leading-relaxed text-slate-400">
                Newest first. Every deploy gets a version and a downloadable build, because a deploy nobody can name is
                a deploy nobody can roll back to — so this list is the whole history, patches included, not a
                highlights reel.
            </p>
            <p class="reveal is-visible mt-3 text-sm text-slate-500">
                {/* The space is an expression: Astro strips whitespace before an
                    inline tag, and "is" would end up welded to the version. */}
                {RELEASES.length} releases · the current one is{" "}
                <a href={`${REPO}/releases/tag/v${RELEASES[0]!.version}`} target="_blank" rel="noopener"
                   class="font-medium text-slate-300 underline decoration-cyan-400/40 underline-offset-4 transition hover:text-cyan-300">v{RELEASES[0]!.version}</a>
            </p>
        </div>
    </section>

    <section class="relative px-4 pb-24">
        <div class="mx-auto w-[min(56rem,100%)]">
            {lines.map(([line, aRelease]) => (
                <div class="mt-10 first:mt-0">
                    <h2 class="reveal sticky top-24 z-10 -mx-2 mb-4 w-fit rounded-lg bg-slate-950/70 px-2 py-1 text-sm font-semibold tracking-widest text-slate-500 uppercase backdrop-blur">
                        {line}
                    </h2>

                    <ol class="relative space-y-4 border-l border-white/10 pl-6">
                        {aRelease.map(r => (
                            <li class="glass reveal relative rounded-2xl p-6">
                                <span class="absolute top-8 -left-[1.87rem] size-2.5 rounded-full bg-cyan-400/80 ring-4 ring-slate-950" aria-hidden="true"></span>

                                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                                    <a
                                        href={`${REPO}/releases/tag/v${r.version}`}
                                        target="_blank"
                                        rel="noopener"
                                        class="font-mono text-lg font-bold text-white underline decoration-cyan-400/30 underline-offset-4 transition hover:decoration-cyan-400"
                                    >
                                        v{r.version}
                                    </a>
                                    <time datetime={r.date} class="text-xs text-slate-500">{dateLabel(r.date)}</time>
                                </div>

                                <h3 class="mt-1 text-lg font-semibold text-slate-100">{r.title}</h3>

                                {r.tools && r.tools.length > 0 && (
                                    <ul class="mt-3 flex flex-wrap gap-1.5">
                                        {r.tools.map(id => {
                                            const oTool = TOOLS.find(t => t.id === id);
                                            return oTool ? (
                                                <li>
                                                    <a
                                                        href={`${base}${oTool.slug}`}
                                                        class="inline-flex items-center gap-1.5 rounded-full bg-white/5 py-1 pr-3 pl-2 text-xs text-slate-300 ring-1 ring-white/10 transition hover:bg-white/10 hover:text-white"
                                                    >
                                                        <ToolIcon tool={oTool} class="size-3.5 text-cyan-300/80" />
                                                        {oTool.short}
                                                    </a>
                                                </li>
                                            ) : null;
                                        })}
                                    </ul>
                                )}

                                <ul class="mt-3 space-y-2">
                                    {r.notes.map(s => (
                                        <li class="flex gap-2.5 text-sm leading-relaxed text-slate-400">
                                            <span class="mt-2 size-1 shrink-0 rounded-full bg-slate-600" aria-hidden="true"></span>
                                            <span>{s}</span>
                                        </li>
                                    ))}
                                </ul>
                            </li>
                        ))}
                    </ol>
                </div>
            ))}

            <p class="reveal mt-10 text-xs leading-relaxed text-slate-500">
                It began as <strong class="text-slate-400">XToolConverter</strong>, a single page that turned an xTool
                Creative Space project into a DXF. Everything before v1.1.0 predates the release history — there was
                nothing to roll back to yet.
            </p>
        </div>
    </section>
</Layout>
